<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Test.Web.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">

<head runat="server">
    <meta charset="utf-8">
    <title>Prueba .NET
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://unicons.iconscout.com" crossorigin="anonymous">
    <link rel="preload" href="/content/main.css" as="style">
    <link rel="preload" href="https://unicons.iconscout.com/release/v3.0.6/css/line.css?display=swap" as="style">
    <link rel="stylesheet" href="/content/main.css">
    <link rel="stylesheet" href="/content/notifications.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v3.0.6/css/line.css?display=swap">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="module" src="/Scripts/main.js"></script>
</head>
<body>

    <header class="header" id="header">
        <nav class="nav container">
            <a href="/#" class="nav-logo">Prueba .NET</a>
            <div class="nav-menu" id="nav-menu">
                <ul class="nav-list grid">
                    <li class="nav-item">
                        <a href="/#" class="nav-link">
                            <i class="uil uil-estate nav-icon"></i>
                            Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/nuevo-cliente" class="nav-link">
                            <i class="uil uil-user nav-icon"></i>
                            Añadir Cliente
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="https://srealmoreno.com/#contact" class="nav-link">
                            <i class="uil uil-message nav-icon"></i>
                            Contácteme
                        </a>
                    </li>
                </ul>
            </div>
            <div class="nav-buttons">
                <button id="theme-toggle" aria-label="theme-toggle" aria-placeholder="theme-toggle" theme="dark">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 472.39 472.39">
                        <g class="toggle-sun">
                            <path d="M403.21,167V69.18H305.38L236.2,0,167,69.18H69.18V167L0,236.2l69.18,69.18v97.83H167l69.18,69.18,69.18-69.18h97.83V305.38l69.18-69.18Zm-167,198.17a129,129,0,1,1,129-129A129,129,0,0,1,236.2,365.19Z"></path>
                        </g>
                        <g class="toggle-circle">
                            <circle class="cls-1" cx="236.2" cy="236.2" r="103.78"></circle>
                        </g>
                    </svg>
                </button>
                <div class="nav-toggle" id="nav-toggle" aria-label="nav-toggle" aria-placeholder="nav-toggle">
                    <i class="uil uil-apps nav-icon"></i>
                </div>
            </div>
        </nav>
    </header>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
            </Scripts>
        </asp:ScriptManager>

        <main class="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
    </form>
    <asp:PlaceHolder runat="server">
    </asp:PlaceHolder>
</body>
</html>
